# Vault password (used by all scripts; prompt is used if unset)
VAULT_PASSWORD=your-vault-password-here

# Workspace root to scan for .env files (defaults to the repo directory)
# CREDENTIAL_VAULT_WORKSPACE=/path/to/your/workspace

# Optional: a wallet address to verify against the vault contents
# (backup-envs.py verify)
# VERIFY_WALLET=0x0000000000000000000000000000000000000000
